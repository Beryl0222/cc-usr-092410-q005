{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "数字文化展项立项台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "THESIS_SUBMITTED",
        "SOURCE_CLEARED",
        "SIMILARITY_FLAGGED",
        "CHANGE_REVIEWED",
        "VERSION_RELEASED",
        "SOURCE_WITHDRAWN",
        "COMPONENT_REGISTERED",
        "COMPONENT_RELEASED",
        "COMPONENT_DEPLOYED",
        "RETIREMENT_INITIATED",
        "DEPLOYMENT_SCOPE_FROZEN",
        "EMERGENCY_BLOCK_ISSUED",
        "REPLACEMENT_PLAN_SUBMITTED",
        "RETIREMENT_SIGNED",
        "RETIREMENT_ITEM_DECIDED",
        "EXECUTION_RECEIPT_RECORDED",
        "RECEIPT_CONFLICT_FLAGGED",
        "INVESTIGATION_RESOLVED",
        "RETIREMENT_BATCH_CLOSED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "curatorial_thesis",
        "research_asset",
        "experience_proposal",
        "interactive_component",
        "digital_exhibit",
        "component_retirement",
        "approval_decision"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "causation_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
