{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "数字文化展项立项台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "THESIS_SUBMITTED",
        "SOURCE_CLEARED",
        "SIMILARITY_FLAGGED",
        "CHANGE_REVIEWED",
        "VERSION_RELEASED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "curatorial_thesis",
        "research_asset",
        "experience_proposal",
        "approval_decision"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
